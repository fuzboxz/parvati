# --------------------------------------------------------------------------- #
# Hellcat — .gitignore
# --------------------------------------------------------------------------- #

# --- macOS ---
.DS_Store
._*

# --- IDEs / editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.cache/

# --- Build artefacts (CMake / JUCE / Projucer) ---
build/
build_*/
build_ios/
Builds/
JuceLibraryCode/
cmake-build-*/
out/
[Cc]ache/

# --- Compiled objects / archives ---
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# --- Plugin binaries (never track built plug-ins) ---
*.vst3
*.component
*.app
*.vst
*.aulib

# --- Vendored reference trees (have their own history / licensing) ---
ambika_reference/

# --- Pi subagent scratch / artefacts ---
.pi-subagents/
.pi/

# --- Coverage / profiling / sanitizer output ---
*.gcda
*.gcno
*.gcov
*.prof
coverage/
asio_profiler_output/

# --- Temporary test artefacts ---
*.tmp
*.bak

# Machine-local performance baseline (harvested per host; see
# tests/perf_baseline_test.cpp) ---
tests/perf_baseline.local.json

# --- Generated menu screenshots (tools/menu_shots.cpp) ---
screens/
__pycache__/

# --- Root-level hygiene -------------------------------------------------------
# Working/analysis markdown belongs in audit/ (dated reports) or docs/ (curated
# design docs), never loose at the repo root. Ignore any root-level *.md that is
# not one of the canonical files, so WIP notes cannot be committed there.
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/NOTICES.md
!/CLAUDE.md

# --- Generated user manual PDF (the .md source and tools/gen_manual.py are tracked) ---
docs/manual/*.pdf

# --- Manual screenshots (tools/screen_shots.cpp renders them on demand;
# regenerate with: cmake --build build_unified --target hellcat_screen_shots &&
# ./build_unified/hellcat_screen_shots docs/manual/screens 2) ---
docs/manual/screens/
